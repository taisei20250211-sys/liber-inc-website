---

<div class="card" data-animate>
  <div class="card-illust" style={`background: ${gradients[id]}`}>
    <div class="illust-svg" set:html={illustrations[id]} />
    <div class="card-label">
      <span class="name-en">{name}</span>
      <span class="name-ja">{nameJa}</span>
    </div>
  </div>
  <div class="card-body">
    <p class="description">{description}</p>
    <ul class="responsibilities">
      {responsibilities.map((item) => (
        <li>
          <span class="dot" style={`background: ${color}`}></span>
          {item}
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.25s, transform 0.25s;
    opacity: 0;
    transform: translateY(24px);
  }

  .card.visible {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.5s ease, transform 0.5s ease, box-shadow 0.25s, border-color 0.25s;
  }

  .card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .card-illust {
    position: relative;
    height: 130px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .illust-svg {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .illust-svg svg {
    width: 100%;
    height: 100%;
  }

  .card-label {
    position: absolute;
    bottom: 14px;
    left: 20px;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .name-en {
    font-size: 1.15rem;
    font-weight: 800;
    color: white;
    letter-spacing: -0.01em;
    line-height: 1;
  }

  .name-ja {
    font-size: 0.72rem;
    color: rgba(255,255,255,0.65);
    font-weight: 500;
  }

  .card-body {
    padding: 20px 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex: 1;
  }

  .description {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.75;
  }

  .responsibilities {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .responsibilities li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.85rem;
    color: var(--color-text);
    font-weight: 500;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }
</style>
