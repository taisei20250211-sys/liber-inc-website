---
interface Props {
  id: string;
  name: string;
  nameJa: string;
  description: string;
  responsibilities: string[];
  icon: string;
  color: string;
}

const { name, nameJa, description, responsibilities, icon, color } = Astro.props;

const icons: Record<string, string> = {
  briefcase: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>`,
  megaphone: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 11 19-9-9 19-2-8-8-2z"/></svg>`,
  layers: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>`,
  book: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>`,
};
---

<div class="card">
  <div class="card-header">
    <div class="icon-wrap" style={`background: ${color}15; color: ${color}`} set:html={icons[icon]} />
    <div class="card-title">
      <span class="name-en">{name}</span>
      <span class="name-ja">{nameJa}</span>
    </div>
  </div>
  <p class="description">{description}</p>
  <ul class="responsibilities">
    {responsibilities.map((item) => (
      <li>
        <span class="dot" style={`background: ${color}`}></span>
        {item}
      </li>
    ))}
  </ul>
</div>

<style>
  .card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .card-title {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .name-en {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }

  .name-ja {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .description {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .responsibilities {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 4px;
  }

  .responsibilities li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.875rem;
    color: var(--color-text);
    font-weight: 500;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }
</style>
