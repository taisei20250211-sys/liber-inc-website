---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import DepartmentCard from '../components/DepartmentCard.astro';
import Footer from '../components/Footer.astro';
import siteData from '../data/site.json';

const { company, departments, stats } = siteData;
---

<Layout title="Liber Inc. - 運営体制" description={company.description}>
  <Header />

  <main>
    <!-- Hero -->
    <section class="hero">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="hero-noise" aria-hidden="true"></div>
      <!-- Floating shapes -->
      <div class="shape shape-circle-lg" aria-hidden="true"></div>
      <div class="shape shape-circle-md" aria-hidden="true"></div>
      <div class="shape shape-circle-sm" aria-hidden="true"></div>
      <div class="shape shape-ring" aria-hidden="true"></div>
      <div class="shape shape-diamond" aria-hidden="true"></div>
      <div class="shape shape-line-1" aria-hidden="true"></div>
      <div class="shape shape-line-2" aria-hidden="true"></div>
      <div class="container">
        <div class="hero-badge">Liber Inc. — Company Overview</div>
        <h1 class="hero-title">{company.tagline}</h1>
        <p class="hero-description">{company.description}</p>
        <div class="hero-stats">
          {stats.map((stat) => (
            <div class="stat">
              <span class="stat-value">{stat.value}</span>
              <span class="stat-label">{stat.label}</span>
            </div>
          ))}
        </div>
        <a href="#departments" class="cta-btn">
          Explore Our Crew
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m6 9 6 6 6-6"/>
          </svg>
        </a>
      </div>
    </section>

    <!-- Departments -->
    <section id="departments" class="section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">部門紹介</h2>
          <p class="section-subtitle">仲間のように連携する4つの部門。それぞれが専門性を持ちながら、自由に価値を創り続けます</p>
        </div>
        <div class="departments-grid">
          {departments.map((dept) => (
            <DepartmentCard {...dept} />
          ))}
        </div>
      </div>
    </section>

    <!-- Structure -->
    <section id="structure" class="section section-alt">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">運営体制</h2>
          <p class="section-subtitle">自社ブランドを育てながら、クライアントワークも仲間と連携して動く。それがLiber Inc. のスタイル</p>
        </div>

        <!-- Crew Map -->
        <div class="crew-map">
          <!-- SVG connecting lines -->
          <svg class="crew-lines" viewBox="0 0 500 500" fill="none" xmlns="http://www.w3.org/2000/svg">
            <line x1="250" y1="250" x2="110" y2="110" stroke="#3b82f6" stroke-width="1.5" stroke-dasharray="6 4" class="line-animate"/>
            <line x1="250" y1="250" x2="390" y2="110" stroke="#8b5cf6" stroke-width="1.5" stroke-dasharray="6 4" class="line-animate" style="animation-delay: 0.3s"/>
            <line x1="250" y1="250" x2="110" y2="390" stroke="#f59e0b" stroke-width="1.5" stroke-dasharray="6 4" class="line-animate" style="animation-delay: 0.6s"/>
            <line x1="250" y1="250" x2="390" y2="390" stroke="#10b981" stroke-width="1.5" stroke-dasharray="6 4" class="line-animate" style="animation-delay: 0.9s"/>
            <line x1="110" y1="110" x2="390" y2="110" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="4 6" opacity="0.6"/>
            <line x1="110" y1="390" x2="390" y2="390" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="4 6" opacity="0.6"/>
            <line x1="110" y1="110" x2="110" y2="390" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="4 6" opacity="0.6"/>
            <line x1="390" y1="110" x2="390" y2="390" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="4 6" opacity="0.6"/>
          </svg>

          <!-- Center hub -->
          <div class="crew-center">
            <div class="crew-center-pulse"></div>
            <div class="crew-center-inner">
              <span class="crew-center-logo">L</span>
              <span class="crew-center-name">Liber Inc.</span>
            </div>
          </div>

          <!-- Department nodes -->
          <div class="crew-node node-tl" style="--node-color: #3b82f6; --node-bg: #eff6ff">
            <div class="node-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
            </div>
            <div class="node-label">Sales</div>
            <div class="node-sub">営業</div>
          </div>

          <div class="crew-node node-tr" style="--node-color: #8b5cf6; --node-bg: #f5f3ff">
            <div class="node-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 11 19-9-9 19-2-8-8-2z"/></svg>
            </div>
            <div class="node-label">Marketing</div>
            <div class="node-sub">マーケティング</div>
          </div>

          <div class="crew-node node-bl" style="--node-color: #f59e0b; --node-bg: #fffbeb">
            <div class="node-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
            </div>
            <div class="node-label">Knowledge</div>
            <div class="node-sub">ナレッジ</div>
          </div>

          <div class="crew-node node-br" style="--node-color: #10b981; --node-bg: #ecfdf5">
            <div class="node-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
            </div>
            <div class="node-label">Production</div>
            <div class="node-sub">制作</div>
          </div>
        </div>

        <div class="tools-section">
          <h3 class="tools-title">活用ツール・AI</h3>
          <div class="tools-grid">
            <div class="tool-item">
              <span class="tool-badge ai">AI</span>
              <span class="tool-name">Claude (Anthropic)</span>
              <span class="tool-desc">業務自動化・コンテンツ生成・戦略立案</span>
            </div>
            <div class="tool-item">
              <span class="tool-badge ai">AI</span>
              <span class="tool-name">ChatGPT (OpenAI)</span>
              <span class="tool-desc">バナー・LP・広告クリエイティブの画像生成</span>
            </div>
            <div class="tool-item">
              <span class="tool-badge tool">Tool</span>
              <span class="tool-name">Notion</span>
              <span class="tool-desc">タスク・目標管理・ナレッジベース</span>
            </div>
            <div class="tool-item">
              <span class="tool-badge tool">Tool</span>
              <span class="tool-name">Google Workspace</span>
              <span class="tool-desc">スプレッドシート・ドキュメント管理</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="section">
      <div class="container">
        <div class="contact-card">
          <h2 class="contact-title">仲間として、一緒に動こう。</h2>
          <p class="contact-desc">
            クリエイティブ制作・SNS運用・LP制作など、幅広いご依頼に対応しています。
            まずはお気軽にご相談ください。
          </p>
          <a href="mailto:contact@liber-inc.com" class="contact-btn">
            お問い合わせ
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry, i) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const delay = el.dataset.delay ?? '0';
          setTimeout(() => el.classList.add('visible'), parseInt(delay));
          observer.unobserve(el);
        }
      });
    },
    { threshold: 0.1 }
  );

  document.querySelectorAll('[data-animate]').forEach((el, i) => {
    (el as HTMLElement).dataset.delay = String(i * 100);
    observer.observe(el);
  });
</script>

<style>
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Hero */
  .hero {
    position: relative;
    padding: 120px 0 100px;
    overflow: hidden;
    background: #080d1a;
  }

  .hero .container {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 24px;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 50% at 20% 50%, rgba(59, 130, 246, 0.12) 0%, transparent 60%),
      radial-gradient(ellipse 60% 40% at 80% 30%, rgba(212, 175, 55, 0.08) 0%, transparent 60%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-noise {
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-size: 128px;
    pointer-events: none;
    z-index: 1;
    opacity: 0.4;
  }

  /* Floating shapes */
  .shape {
    position: absolute;
    pointer-events: none;
    z-index: 1;
  }

  @keyframes float-slow   { 0%,100% { transform: translateY(0) rotate(0deg); }   50% { transform: translateY(-18px) rotate(5deg); } }
  @keyframes float-med    { 0%,100% { transform: translateY(0) rotate(0deg); }   50% { transform: translateY(-12px) rotate(-8deg); } }
  @keyframes spin-slow    { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  @keyframes pulse-shape  { 0%,100% { opacity: 0.12; transform: scale(1); }      50% { opacity: 0.22; transform: scale(1.08); } }

  .shape-circle-lg {
    width: 320px; height: 320px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.06);
    top: -80px; right: -60px;
    animation: float-slow 8s ease-in-out infinite;
  }
  .shape-circle-md {
    width: 160px; height: 160px;
    border-radius: 50%;
    background: rgba(59,130,246,0.07);
    border: 1px solid rgba(59,130,246,0.15);
    bottom: 40px; left: 5%;
    animation: float-med 6s ease-in-out infinite 1s;
  }
  .shape-circle-sm {
    width: 60px; height: 60px;
    border-radius: 50%;
    background: rgba(212,175,55,0.12);
    top: 15%; right: 18%;
    animation: pulse-shape 4s ease-in-out infinite;
  }
  .shape-ring {
    width: 200px; height: 200px;
    border-radius: 50%;
    border: 2px solid rgba(212,175,55,0.1);
    bottom: -40px; right: 12%;
    animation: spin-slow 20s linear infinite;
  }
  .shape-diamond {
    width: 28px; height: 28px;
    background: rgba(212,175,55,0.25);
    transform: rotate(45deg);
    top: 30%; left: 8%;
    animation: float-med 5s ease-in-out infinite 2s;
  }
  .shape-line-1 {
    width: 120px; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent);
    top: 25%; right: 8%;
    animation: float-slow 7s ease-in-out infinite 0.5s;
  }
  .shape-line-2 {
    width: 80px; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(212,175,55,0.2), transparent);
    top: 60%; left: 12%;
    transform: rotate(-30deg);
    animation: float-med 6s ease-in-out infinite 3s;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    padding: 5px 16px;
    background: rgba(212, 175, 55, 0.12);
    color: #d4af37;
    border: 1px solid rgba(212, 175, 55, 0.25);
    border-radius: 100px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-title {
    font-size: clamp(2.2rem, 5.5vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: #ffffff;
  }

  .hero-description {
    max-width: 560px;
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.9;
  }

  .hero-stats {
    display: flex;
    gap: 0;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius);
    margin-top: 8px;
    overflow: hidden;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 20px 36px;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
  }

  .stat:last-child {
    border-right: none;
  }

  .stat-value {
    font-size: 1.4rem;
    font-weight: 700;
    color: #d4af37;
    letter-spacing: -0.02em;
  }

  .stat-label {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.4);
    font-weight: 500;
    white-space: nowrap;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 28px;
    background: #d4af37;
    color: #080d1a;
    border-radius: 10px;
    font-weight: 700;
    font-size: 0.95rem;
    transition: background 0.15s, transform 0.15s;
    margin-top: 4px;
    letter-spacing: 0.01em;
  }

  .cta-btn:hover {
    background: #e8c84a;
    transform: translateY(-2px);
  }

  /* Sections */
  .section {
    padding: 80px 0;
  }

  .section-alt {
    background: white;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .section-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .section-title {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 10px;
  }

  .section-subtitle {
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  /* Departments Grid */
  .departments-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  /* Crew Map */
  .crew-map {
    position: relative;
    width: 420px;
    height: 420px;
    margin: 0 auto 48px;
  }

  .crew-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  @keyframes dash-move {
    to { stroke-dashoffset: -20; }
  }

  .line-animate {
    animation: dash-move 2s linear infinite;
  }

  /* Center hub */
  .crew-center {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .crew-center-pulse {
    position: absolute;
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: rgba(59, 130, 246, 0.08);
    animation: pulse-ring 2.5s ease-out infinite;
  }

  @keyframes pulse-ring {
    0% { transform: scale(0.85); opacity: 0.8; }
    100% { transform: scale(1.4); opacity: 0; }
  }

  .crew-center-inner {
    position: relative;
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, #3b82f6, #2563eb);
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 32px rgba(59, 130, 246, 0.3);
    gap: 1px;
  }

  .crew-center-logo {
    font-size: 1.4rem;
    font-weight: 800;
    color: white;
    line-height: 1;
  }

  .crew-center-name {
    font-size: 0.5rem;
    font-weight: 600;
    color: rgba(255,255,255,0.8);
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  /* Department nodes */
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  .crew-node {
    position: absolute;
    width: 110px;
    background: var(--node-bg);
    border: 2px solid var(--node-color);
    border-radius: 14px;
    padding: 14px 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-align: center;
    box-shadow: 0 4px 16px rgba(0,0,0,0.06);
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .crew-node:hover {
    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    transform: scale(1.05) !important;
  }

  .node-tl { top: 20px;  left: 20px;  animation: float 4s ease-in-out infinite; }
  .node-tr { top: 20px;  right: 20px; animation: float 4s ease-in-out infinite 0.8s; }
  .node-bl { bottom: 20px; left: 20px;  animation: float 4s ease-in-out infinite 1.6s; }
  .node-br { bottom: 20px; right: 20px; animation: float 4s ease-in-out infinite 2.4s; }

  .node-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: white;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--node-color);
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  }

  .node-label {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1;
  }

  .node-sub {
    font-size: 0.68rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  @media (max-width: 480px) {
    .crew-map {
      width: 320px;
      height: 320px;
    }
    .crew-node {
      width: 84px;
      padding: 10px 8px;
    }
    .crew-center-inner {
      width: 64px;
      height: 64px;
    }
  }

  /* Tools */
  .tools-section {
    padding-top: 32px;
    border-top: 1px solid var(--color-border);
  }

  .tools-title {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 20px;
    color: var(--color-text);
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .tool-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 8px;
  }

  .tool-badge {
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .tool-badge.ai {
    background: rgba(139, 92, 246, 0.1);
    color: #8b5cf6;
  }

  .tool-badge.tool {
    background: rgba(59, 130, 246, 0.1);
    color: var(--color-primary);
  }

  .tool-name {
    font-weight: 600;
    font-size: 0.875rem;
    flex-shrink: 0;
  }

  .tool-desc {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  /* Contact */
  .contact-card {
    background: linear-gradient(135deg, var(--color-primary) 0%, #2563eb 100%);
    border-radius: 16px;
    padding: 60px;
    text-align: center;
    color: white;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .contact-title {
    font-size: 1.8rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .contact-desc {
    max-width: 520px;
    font-size: 0.95rem;
    opacity: 0.85;
    line-height: 1.8;
  }

  .contact-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 28px;
    background: white;
    color: var(--color-primary);
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.95rem;
    margin-top: 8px;
    transition: opacity 0.15s, transform 0.15s;
  }

  .contact-btn:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .departments-grid {
      grid-template-columns: 1fr;
    }

    .hero-stats {
      gap: 24px;
      padding: 20px 28px;
    }

    .structure-flow {
      flex-direction: column;
    }

    .flow-arrow {
      transform: rotate(90deg);
    }

    .knowledge-arrow {
      transform: none;
    }

    .tools-grid {
      grid-template-columns: 1fr;
    }

    .contact-card {
      padding: 40px 24px;
    }
  }
</style>
